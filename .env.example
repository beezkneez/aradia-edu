# Database connection (same as aradia-time to share user auth)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server port
PORT=3400

# Bunny Stream (video hosting) — from the video library's API tab in Bunny.
# New edu videos upload here; without these, in-app upload is disabled but
# existing Google Drive videos keep working.
BUNNY_STREAM_LIBRARY_ID=your_library_id
BUNNY_STREAM_API_KEY=your_library_api_key
# CDN hostname (optional, for future direct HLS playback), e.g. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=

# Bunny Storage (manual PDF hosting) — from the Storage Zone's FTP & API Access tab.
# Without these, manual upload falls back to an error; existing manuals keep working.
BUNNY_STORAGE_ZONE=your_storage_zone_name
BUNNY_STORAGE_PASSWORD=your_storage_zone_password
BUNNY_STORAGE_HOSTNAME=your-pull-zone.b-cdn.net
# BUNNY_STORAGE_API_HOST=storage.bunnycdn.com  # override only for non-Frankfurt regions
